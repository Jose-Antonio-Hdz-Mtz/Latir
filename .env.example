# =====================================================================
# Variables de Entorno — LATIR
# Copia este archivo como .env y llena los valores reales
# ¡NUNCA subas el archivo .env a GitHub!
# =====================================================================

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000

# Entorno: 'production' en Render, 'development' en local
NODE_ENV=development

# URL de conexión a PostgreSQL
# Render te proporciona esta URL al crear la base de datos
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://usuario:password@localhost:5432/latirdb

# =====================================================================
# Twilio (Opcional - para notificaciones por SMS/WhatsApp)
# =====================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=
